{
  "$comment": "Writers config. 正常不用改这个文件：四个写侧脚本默认读 ~/.dsh/wk-inject/wk-inject.config.json 的 writers 段，本文件只是出厂默认值与 --config 的示例。apiKey 留空即可，它取共享配置里的那把，或环境变量 WEKNORA_API_KEY。",
  "apiUrl": "http://127.0.0.1:8080/api/v1",
  "apiKey": "",
  "sessionsRoot": "",
  "kbs": {
    "session": "",
    "knowledge": "",
    "material": ""
  },
  "ingest": {
    "enabled": true,
    "titlePrefix": "会话记录 ",
    "settleMinutes": 10,
    "maxDocBytes": 200000,
    "maxSessionDocs": 150,
    "skipSubagentSessions": true,
    "maxAttempts": 3,
    "pollTimeoutSec": 600
  },
  "distill": {
    "enabled": true,
    "titlePrefix": "记忆 ",
    "maxSessionsPerRun": 3,
    "maxDocsPerRun": 3,
    "maxInputChars": 30000,
    "perTurnChars": 1500,
    "maxEntriesPerSession": 8,
    "semanticDedupe": {
      "enabled": true,
      "scoreMin": 0.66
    }
  },
  "dream": {
    "enabled": true,
    "titlePrefix": "[fact] ",
    "maxLlmCalls": 60,
    "maxUpdates": 20,
    "grouping": {
      "searchTopK": 5,
      "queryChars": 120,
      "sameRootScore": 0.5,
      "crossRootScore": 0.6,
      "maxCluster": 5
    }
  },
  "profile": {
    "enabled": true,
    "path": "data/profile.json",
    "statsPath": "data/profile-stats.json"
  },
  "llm": {
    "mode": "weknora-session-chat",
    "modelName": "builtin-deepseek-flash",
    "timeoutMs": 240000
  },
  "enabled": false,
  "tasks": {
    "ingest": "hourly",
    "distill": "00:00",
    "dream": "00:30"
  }
}
